#!/usr/bin/env bash
# cbus — claude session bus. tiny file-based message bus so live Claude Code
# sessions can talk, organized into named channels.
#
# layout ($CBUS_DIR, default ~/.claude-bus):
#   <channel>/<alias>/meta.json    {alias, channel, sessionId, cwd, listenerPid, ownerPid, host, ts}
#   <channel>/<alias>/inbox.jsonl  append-only, one JSON message per line
#
# a session joins a channel (alias auto-picked: main, then fork-N), then arms
# `cbus tail <channel>/<alias>` under the Monitor tool to receive. any process
# reaches it with `cbus send <channel>/<alias> "text"`; a bare alias resolves
# within the sender's own channel(s). the channel name "global" is reserved by
# convention as the machine-wide bus for a master orchestrator.
set -euo pipefail

CBUS_DIR="${CBUS_DIR:-$HOME/.claude-bus}"
PY="${CBUS_PYTHON:-python3}"

die() { printf 'cbus: %s\n' "$*" >&2; exit 1; }
now() { date -u +%Y-%m-%dT%H:%M:%SZ; }

command -v "$PY" >/dev/null 2>&1 || die "python3 not found (set CBUS_PYTHON)"

valid_name() { [[ "$1" != . && "$1" != .. && "$1" =~ ^[A-Za-z0-9._-]+$ ]]; }

meta_path()  { printf '%s/%s/%s/meta.json'   "$CBUS_DIR" "$1" "$2"; }
inbox_path() { printf '%s/%s/%s/inbox.jsonl' "$CBUS_DIR" "$1" "$2"; }

# read a scalar field out of a json file
jget() { # <file> <field>
  [ -f "$1" ] || return 1
  "$PY" -c 'import json,sys
try: print(json.load(open(sys.argv[1])).get(sys.argv[2],"") or "")
except Exception: pass' "$1" "$2"
}

pid_alive() { [ -n "${1:-}" ] && kill -0 "$1" 2>/dev/null; }

# walk up from the current process to the owning Claude Code process, so the
# listener can be tied to the *session's* liveness, not just the tail's. an
# orphaned tail (after a session crash) keeps running with a live pid, but its
# owning `claude` pid is gone — that's the signal we record. prints the pid, or
# nothing if no claude ancestor is found (caller falls back to pid-only checks).
find_owner_pid() {
  local p="$PPID" depth=0 comm
  while [ -n "$p" ] && [ "$p" -gt 1 ] && [ "$depth" -lt 16 ]; do
    comm="$(ps -p "$p" -o comm= 2>/dev/null || true)"
    case "${comm##*/}" in claude|claude-*) printf '%s\n' "$p"; return 0 ;; esac
    p="$(ps -p "$p" -o ppid= 2>/dev/null | tr -d ' ')"
    depth=$((depth+1))
  done
  return 1
}

# a recorded listener is truly alive only if: its pid exists, that pid is still
# *this* tail (args reference the inbox — guards against pid recycling), and the
# owning session pid, if recorded, is alive (guards against an orphaned tail).
meta_listener_alive() { # <meta.json>
  local pid owner inbox
  pid="$(jget "$1" listenerPid || true)"
  [ -n "$pid" ] || return 1
  pid_alive "$pid" || return 1
  inbox="$(dirname "$1")/inbox.jsonl"
  ps -ww -p "$pid" -o args= 2>/dev/null | grep -qF -- "$inbox" || return 1
  owner="$(jget "$1" ownerPid || true)"
  [ -n "$owner" ] || return 0
  pid_alive "$owner"
}

# patch a single field into an existing meta.json (value "" clears it to null)
jset() { # <file> <field> <value>
  [ -f "$1" ] || return 1
  "$PY" -c 'import json,sys
m=json.load(open(sys.argv[1]))
v=sys.argv[3]
m[sys.argv[2]] = (int(v) if v.isdigit() else (None if v=="" else v))
json.dump(m, open(sys.argv[1],"w"), indent=2)' "$1" "$2" "$3"
}

# split "channel/alias" (or bare "alias") into T_CH / T_AL
T_CH="" T_AL=""
split_target() {
  case "$1" in
    */*) T_CH="${1%%/*}"; T_AL="${1#*/}" ;;
    *)   T_CH="";         T_AL="$1" ;;
  esac
  [ -z "$T_CH" ] || valid_name "$T_CH" || die "bad channel \"$T_CH\""
  valid_name "$T_AL" || die "bad alias \"$T_AL\""
}

# every channel/alias registered to the current CLAUDE_CODE_SESSION_ID
resolve_self() {
  local sid="${CLAUDE_CODE_SESSION_ID:-}" m found=0
  [ -n "$sid" ] || return 1
  for m in "$CBUS_DIR"/*/*/meta.json; do
    [ -f "$m" ] || continue
    if [ "$(jget "$m" sessionId)" = "$sid" ]; then
      printf '%s/%s\n' "$(basename "$(dirname "$(dirname "$m")")")" \
                       "$(basename "$(dirname "$m")")"
      found=1
    fi
  done
  [ "$found" -eq 1 ]
}

# find a bare alias among the sender's own channels
find_peer_channel() { # <alias>
  local al="$1" line ch
  while IFS= read -r line; do
    ch="${line%%/*}"
    [ -f "$(meta_path "$ch" "$al")" ] && { printf '%s\n' "$ch"; return 0; }
  done < <(resolve_self 2>/dev/null || true)
  return 1
}

# ---- remote (relay-backed) channels: <channel>@<host>/<alias> ----
# a remote channel lives AT a relay site; aliases are explicit by convention
# (short hostname/role). collisions are self-evident: the relay keeps one
# active tail per peer, so a taken alias visibly displaces the other Monitor.

R_CH="" R_HOST="" R_AL=""
split_remote() { # <channel>@<host>[/<alias>]  (empty channel allowed for list)
  local rest="${1#*@}"
  R_CH="${1%%@*}"
  case "$rest" in
    */*) R_HOST="${rest%%/*}"; R_AL="${rest#*/}" ;;
    *)   R_HOST="$rest";       R_AL="" ;;
  esac
  [ -z "$R_CH" ] || valid_name "$R_CH" || die "bad channel \"$R_CH\""
  valid_name "$R_HOST" || die "bad host \"$R_HOST\""
  [ -z "$R_AL" ] || valid_name "$R_AL" || die "bad alias \"$R_AL\""
}

site_public_url() { # <host> — env CBUS_SITE_<HOST>_URL overrides the built-in
  # any non-alphanumeric in the host (dots allowed by valid_name) maps to _
  # so the constructed name is always a valid identifier under set -eu
  local var="CBUS_SITE_$(printf '%s' "$1" | tr '[:lower:]' '[:upper:]' | tr -c 'A-Z0-9' '_' | sed 's/_$//')_URL"
  local v="${!var:-}"
  if [ -n "$v" ]; then printf '%s' "$v"; return; fi
  case "$1" in
    nuc) printf 'https://bus.example.com' ;;
    *) die "unknown relay host \"$1\" (set $var)" ;;
  esac
}

# front-door pick: a session ON the relay host reaches it at loopback (no CF
# Access); everyone else goes through the public hostname. zero config — probe.
relay_base() { # <host> -> "local <url>" | "public <url>"
  local lu="${CBUS_RELAY_LOCAL_URL:-http://127.0.0.1:8090}"
  if curl -fsS -m 0.3 "$lu/healthz" 2>/dev/null | grep -q '^ok$'; then
    printf 'local %s' "$lu"
  else
    printf 'public %s' "$(site_public_url "$1")"
  fi
}

ws_url() { # http(s) url -> ws(s) url
  case "$1" in
    https://*) printf 'wss://%s' "${1#https://}" ;;
    http://*)  printf 'ws://%s'  "${1#http://}" ;;
  esac
}

# credentials: macOS Keychain (security(1)); Linux 0600 files. never hardcoded.
auth_store_dir() { printf '%s/cbus/%s' "${XDG_CONFIG_HOME:-$HOME/.config}" "$1"; }
auth_get() { # <host> <field: token|cf-id|cf-secret>
  if [ "$(uname -s)" = Darwin ]; then
    security find-generic-password -s "cbus-relay-$1" -a "$2" -w 2>/dev/null
  else
    cat "$(auth_store_dir "$1")/$2" 2>/dev/null
  fi
}
auth_put() { # <host> <field> <value>
  if [ "$(uname -s)" = Darwin ]; then
    # security -i reads the command from stdin, keeping the secret out of argv
    printf 'add-generic-password -U -s "cbus-relay-%s" -a "%s" -w "%s"\n' \
      "$1" "$2" "$3" | security -i >/dev/null
  else
    local d; d="$(auth_store_dir "$1")"
    (umask 077 && mkdir -p "$d" && printf '%s' "$3" > "$d/$2")
  fi
}

# identity marker: SESSION-scoped — arming a remote tail claims that alias as
# THIS session's default `from` on that channel (--from overrides per send).
# layout: .remote/<host>/<channel>/<sessionId> = {alias, ownerPid, ts}.
# per-session slots mean two sessions can hold different aliases on the same
# remote channel; ownerPid gives prune the same liveness rule as local peers.
marker_sid()  { printf '%s' "${CLAUDE_CODE_SESSION_ID:-nosession-$PPID}"; }
marker_dir()  { printf '%s/.remote/%s/%s' "$CBUS_DIR" "$1" "$2"; }      # <host> <ch>
marker_file() { printf '%s/%s' "$(marker_dir "$1" "$2")" "$(marker_sid)"; }

# sweep markers whose owning claude pid is gone; legacy machine-global markers
# (a FILE at the channel path) are unowned by definition — always swept.
prune_remote_markers() {
  local hostdir chdir f pid
  for hostdir in "$CBUS_DIR"/.remote/*/; do
    [ -d "$hostdir" ] || continue
    for chdir in "$hostdir"*; do
      [ -e "$chdir" ] || continue
      if [ -f "$chdir" ]; then
        rm -f "$chdir"
        printf 'pruned legacy remote marker %s@%s\n' \
          "$(basename "$chdir")" "$(basename "$hostdir")" >&2
        continue
      fi
      for f in "$chdir"/*; do
        [ -f "$f" ] || continue
        pid="$(jget "$f" ownerPid || true)"
        if ! pid_alive "$pid"; then
          rm -f "$f"
          printf 'pruned remote marker %s@%s (session %s, owner %s)\n' \
            "$(basename "$chdir")" "$(basename "$hostdir")" \
            "$(basename "$f")" "${pid:-none}" >&2
        fi
      done
      rmdir "$chdir" 2>/dev/null || true
    done
    rmdir "$hostdir" 2>/dev/null || true
  done
}

# print auth headers as a curl config (fed to `curl -K -` on stdin) so
# credentials never appear in any process's argv — visible via ps otherwise
relay_auth_config() { # <host> <mode>
  local token cfid cfsec
  token="$(auth_get "$1" token)" || die "no relay token for \"$1\" — run: cbus auth set $1 --token -"
  printf 'header = "Authorization: Bearer %s"\n' "$token"
  if [ "$2" = public ]; then
    cfid="$(auth_get "$1" cf-id)"   || die "no cf-id for \"$1\" — run: cbus auth set $1 --cf-id -"
    cfsec="$(auth_get "$1" cf-secret)" || die "no cf-secret for \"$1\" — run: cbus auth set $1 --cf-secret -"
    printf 'header = "CF-Access-Client-Id: %s"\n'     "$cfid"
    printf 'header = "CF-Access-Client-Secret: %s"\n' "$cfsec"
  fi
}

cmd_send_remote() { # <ch@host/alias> [--from X] <text...>
  split_remote "$1"; shift
  [ -n "$R_AL" ] || die "remote send needs <channel>@<host>/<alias>"
  local from=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --from) from="${2:?}"; shift 2 ;;
      --force) shift ;;   # meaningless remotely: the spool always queues
      *) break ;;
    esac
  done
  local text="$*"
  [ -n "$text" ] || die "empty message"
  local mode base cfg; read -r mode base <<<"$(relay_base "$R_HOST")"
  cfg="$(relay_auth_config "$R_HOST" "$mode")"
  if [ -z "$from" ]; then
    # per-session identity only: an unrelated session must never inherit
    # another session's alias (that misroutes replies to the wrong Monitor)
    local mf al; mf="$(marker_file "$R_HOST" "$R_CH")"
    if [ -f "$mf" ] && al="$(jget "$mf" alias)" && [ -n "$al" ]; then
      from="$R_CH@$R_HOST/$al"
    else
      from="$(hostname -s 2>/dev/null || hostname)-$PPID"  # unroutable; documented
    fi
  fi
  local payload
  payload="$(CH="$R_CH" AL="$R_AL" FROM="$from" TEXT="$text" "$PY" -c 'import json,os
print(json.dumps({"channel":os.environ["CH"],"alias":os.environ["AL"],
"from":os.environ["FROM"],"text":os.environ["TEXT"]}))')"
  printf '%s\n' "$cfg" | curl -fsS -K - -X POST "$base/send" \
    -H "Content-Type: application/json" -d "$payload" >/dev/null \
    || die "relay send failed ($mode $base)"
  printf 'sent to %s@%s/%s via %s relay (from %s)\n' "$R_CH" "$R_HOST" "$R_AL" "$mode" "$from"
}

cmd_tail_remote() { # <ch@host/alias> — emit the Monitor ws arm spec + claim identity
  split_remote "$1"
  [ -n "$R_AL" ] || die "remote tail needs <channel>@<host>/<alias>"
  local mode base token; read -r mode base <<<"$(relay_base "$R_HOST")"
  token="$(auth_get "$R_HOST" token)" || die "no relay token for \"$R_HOST\" — run: cbus auth set $R_HOST --token -"
  local url; url="$(ws_url "$base")/tail?channel=$R_CH&alias=$R_AL"
  local md; md="$(marker_dir "$R_HOST" "$R_CH")"
  [ -f "$md" ] && rm -f "$md"   # legacy machine-global marker: unowned, replace
  mkdir -p "$md"
  "$PY" -c 'import json,sys
json.dump({"alias":sys.argv[1],"ownerPid":int(sys.argv[2]),"ts":sys.argv[3]},
open(sys.argv[4],"w"), indent=2)' \
    "$R_AL" "$(find_owner_pid || echo "$PPID")" "$(now)" "$(marker_file "$R_HOST" "$R_CH")"
  cat <<EOF
remote listening is armed with the Monitor tool's ws source (not a command):
  url:         $url
  protocols:   ["bearer.cbus.$token"]
  description: cbus:$R_CH@$R_HOST/$R_AL   (persistent: true)
identity recorded for THIS session: sends to $R_CH@$R_HOST/* default to from=$R_CH@$R_HOST/$R_AL
note: the protocols entry carries the relay token — expected; it IS the auth.
EOF
}

cmd_list_remote() { # [<ch>]@<host> — thin read of the relay's /peers
  split_remote "$1"
  local mode base cfg; read -r mode base <<<"$(relay_base "$R_HOST")"
  cfg="$(relay_auth_config "$R_HOST" "$mode")"
  printf '%s\n' "$cfg" | curl -fsS -K - "$base/peers" | CH="$R_CH" HOST="$R_HOST" "$PY" -c 'import json,os,sys
peers=json.load(sys.stdin); ch=os.environ["CH"]; host=os.environ["HOST"]; shown=False
for key in sorted(peers):
    c,_,a=key.partition("/")
    if ch and c!=ch: continue
    p=peers[key]; shown=True
    state="listen" if p.get("connected") else "off   "
    queued=p.get("queued",0); seen=p.get("lastSeen","?")
    addr="%s@%s/%s" % (c,host,a)
    print("%s  %-28s queued=%-3s lastSeen=%s" % (state,addr,queued,seen))
if not shown:
    print("no remote peers" + ((" in %s@%s" % (ch,host)) if ch else ""))'
}

# a peer is dead when its listener pid is gone — but a peer that never armed
# (listenerPid null) gets a grace window so join's auto-prune can't sweep a
# sibling that joined moments ago and hasn't started its Monitor yet.
peer_dead() { # <meta.json>
  local pid; pid="$(jget "$1" listenerPid || true)"
  if [ -z "$pid" ]; then
    [ -n "$(find "$1" -mmin +10 2>/dev/null)" ]
  else
    ! meta_listener_alive "$1"
  fi
}

# announce a presence event to every non-dead peer in <channel> except <self>.
# uses the SAME !peer_dead rule as send, so a joined-but-unarmed peer still gets
# it (replayed on its first arm) — meta_listener_alive alone would skip it. the
# line carries kind=presence so the tail renders it as a compact one-liner.
broadcast_presence() { # <channel> <self-alias> <event: join|leave|rename|departed> <text>
  local ch="$1" self="$2" event="$3" text="$4" chdir="$CBUS_DIR/$1" d peer meta line
  [ -d "$chdir" ] || return 0
  for d in "$chdir"/*/; do
    meta="$d/meta.json"; [ -f "$meta" ] || continue
    peer="$(basename "${d%/}")"
    [ "$peer" = "$self" ] && continue
    peer_dead "$meta" && continue
    line="$(FROM="$ch/$self" TO="$ch/$peer" TS="$(now)" EVENT="$event" TEXT="$text" "$PY" -c 'import json,os
print(json.dumps({"from":os.environ["FROM"],"to":os.environ["TO"],"ts":os.environ["TS"],
"kind":"presence","event":os.environ["EVENT"],"text":os.environ["TEXT"]}))')"
    printf '%s\n' "$line" >> "$(inbox_path "$ch" "$peer")"
  done
}

# drop dead peers in one channel; remove the channel dir once empty.
# also clears a legacy v1 entry (meta.json directly at channel level).
prune_channel() { # <channel>
  local chdir="$CBUS_DIR/$1" d
  [ -d "$chdir" ] || return 0
  if [ -f "$chdir/meta.json" ]; then
    if peer_dead "$chdir/meta.json"; then
      rm -rf "$chdir"
      printf 'pruned legacy peer %s\n' "$1" >&2
    fi
    return 0
  fi
  for d in "$chdir"/*/; do
    [ -f "$d/meta.json" ] || continue
    if peer_dead "$d/meta.json"; then
      local peer tmp; peer="$(basename "${d%/}")"; tmp="${d%/}.reap.$$"
      # atomic claim: mv wins for exactly one concurrent reaper, so the departed
      # event fires once even if two sessions prune the same dead peer at once.
      if mv "${d%/}" "$tmp" 2>/dev/null; then
        printf 'pruned %s/%s\n' "$1" "$peer" >&2
        rm -rf "$tmp"
        broadcast_presence "$1" "$peer" departed "departed (listener gone)"
      fi
    fi
  done
  rmdir "$chdir" 2>/dev/null || true
}

pick_alias() { # <channel> — main if free, else lowest free fork-N
  local ch="$1" n=1
  [ -f "$(meta_path "$ch" main)" ] || { echo main; return; }
  while [ -f "$(meta_path "$ch" "fork-$n")" ]; do n=$((n+1)); done
  echo "fork-$n"
}

cmd_join() { # <channel> [alias]
  local ch="${1:?usage: cbus join <channel> [alias]}"
  local alias="${2:-}"
  valid_name "$ch" || die "channel must be [A-Za-z0-9._-]"
  prune_channel "$ch"
  local line
  while IFS= read -r line; do
    if [ "${line%%/*}" = "$ch" ]; then
      printf 'already joined "%s" as "%s"\n' "$ch" "${line#*/}"
      printf 'listen (if not armed) with the Monitor tool: cbus tail %s\n' "$line"
      return 0
    fi
  done < <(resolve_self 2>/dev/null || true)
  local dir
  if [ -z "$alias" ]; then
    # atomic claim: bare mkdir fails if a concurrently-joining sibling picked
    # the same alias first, so nobody ever truncates another peer's inbox
    mkdir -p "$CBUS_DIR/$ch"
    local tries=0
    while :; do
      alias="$(pick_alias "$ch")"
      dir="$CBUS_DIR/$ch/$alias"
      mkdir "$dir" 2>/dev/null && break
      tries=$((tries+1)); [ "$tries" -lt 50 ] || die "cannot claim an alias in \"$ch\""
    done
  else
    valid_name "$alias" || die "alias must be [A-Za-z0-9._-]"
    local m; m="$(meta_path "$ch" "$alias")"
    [ -f "$m" ] && meta_listener_alive "$m" && die "\"$ch/$alias\" is taken by a live listener"
    dir="$CBUS_DIR/$ch/$alias"
    rm -rf "$dir"
    mkdir -p "$dir"
  fi
  : > "$dir/inbox.jsonl"   # fresh peer, fresh inbox
  "$PY" -c 'import json,sys
json.dump({"alias":sys.argv[1],"channel":sys.argv[2],"sessionId":sys.argv[3],
"cwd":sys.argv[4],"listenerPid":None,"ownerPid":None,"host":sys.argv[5],"ts":sys.argv[6]},
open(sys.argv[7],"w"), indent=2)' \
    "$alias" "$ch" "${CLAUDE_CODE_SESSION_ID:-}" "$PWD" \
    "$(hostname -s 2>/dev/null || hostname)" "$(now)" "$dir/meta.json"
  broadcast_presence "$ch" "$alias" join "joined $ch as $alias"
  printf 'joined channel "%s" as "%s" (session %s)\n' "$ch" "$alias" "${CLAUDE_CODE_SESSION_ID:-none}"
  printf 'address: %s/%s\n' "$ch" "$alias"
  printf 'now arm listening with the Monitor tool: cbus tail %s/%s\n' "$ch" "$alias"
}

cmd_send() { # <target> [--from X] [--force] <text...>
  case "${1:-}" in *@*) cmd_send_remote "$@"; return $? ;; esac
  local target="${1:?usage: cbus send <[channel/]alias> [--from X] <text>}"; shift
  local from="" force=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --from) from="${2:?}"; shift 2 ;;
      --force) force=1; shift ;;
      *) break ;;
    esac
  done
  local text="$*"
  [ -n "$text" ] || die "empty message"
  split_target "$target"
  if [ -z "$T_CH" ]; then
    T_CH="$(find_peer_channel "$T_AL")" \
      || die "no peer \"$T_AL\" in your channels — use <channel>/<alias> (cbus list)"
  fi
  local tmeta; tmeta="$(meta_path "$T_CH" "$T_AL")"
  [ -f "$tmeta" ] || die "no such peer \"$T_CH/$T_AL\" (cbus list)"
  # a peer that joined but never armed still gets the message: its first
  # `tail -n +1` replays the whole inbox. only refuse a dead ex-listener.
  local tpid; tpid="$(jget "$tmeta" listenerPid || true)"
  if [ -n "$tpid" ] && ! meta_listener_alive "$tmeta"; then
    if [ "$force" -eq 1 ]; then
      printf 'cbus: warning: "%s/%s" is not listening — sending anyway\n' "$T_CH" "$T_AL" >&2
    else
      die "\"$T_CH/$T_AL\" is not listening; use --force to queue anyway"
    fi
  fi
  if [ -z "$from" ]; then
    # prefer own registration in the target channel, else first registration
    local line
    while IFS= read -r line; do
      [ -z "$from" ] && from="$line"
      [ "${line%%/*}" = "$T_CH" ] && { from="$line"; break; }
    done < <(resolve_self 2>/dev/null || true)
  fi
  [ -n "$from" ] || from="${CBUS_ALIAS:-$(hostname -s 2>/dev/null || hostname)-$PPID}"
  local line
  line="$(FROM="$from" TO="$T_CH/$T_AL" TS="$(now)" TEXT="$text" "$PY" -c 'import json,os
print(json.dumps({"from":os.environ["FROM"],"to":os.environ["TO"],
"ts":os.environ["TS"],"text":os.environ["TEXT"]}))')"
  printf '%s\n' "$line" >> "$(inbox_path "$T_CH" "$T_AL")"
  printf 'sent to %s/%s (from %s)\n' "$T_CH" "$T_AL" "$from"
}

cmd_tail() { # <channel>/<alias> — used under the Monitor tool
  case "${1:-}" in *@*) cmd_tail_remote "$@"; return $? ;; esac
  split_target "${1:?usage: cbus tail <channel>/<alias>}"
  if [ -z "$T_CH" ]; then
    T_CH="$(find_peer_channel "$T_AL")" || die "use <channel>/<alias>"
  fi
  local inbox; inbox="$(inbox_path "$T_CH" "$T_AL")"
  [ -f "$inbox" ] || die "no such peer \"$T_CH/$T_AL\" — join first"
  # become the listener: exec makes tail inherit our pid, so when the Monitor
  # tool kills this process the recorded pid dies and liveness flips to "off"
  # on its own — no trap needed (a trap can't fire while tail -F is foreground).
  # also record the owning claude pid so a crash-orphaned tail still reads dead.
  local m prev; m="$(meta_path "$T_CH" "$T_AL")"
  prev="$(jget "$m" listenerPid || true)"
  jset "$m" listenerPid "$$" || true
  jset "$m" ownerPid "$(find_owner_pid || echo '')" || true
  # a python follower reframes each message instead of streaming raw JSON. why:
  # the harness Monitor truncates any single stdout line at 500 chars, so one
  # long JSON line per message forces the receiver into a second inbox read. the
  # follower emits a short header (carries from= for replies) + byte-wrapped body
  # lines (<=440B each) + an end marker; the Monitor batches lines written
  # together into ONE notification, so a long message arrives intact in the first
  # event. exec keeps THIS process as the sole Monitor-managed pid, and $inbox is
  # in its argv so meta_listener_alive still recognizes it (no child tail to
  # orphan). start '+1' replays the whole inbox on first arm (join truncated it,
  # so nothing is lost); a RE-arm follows from the end ('0'). the follower re-opens
  # on inode change / shrink to survive a rejoin's truncate, like tail -F.
  local from_line='+1'; [ -n "$prev" ] && from_line='0'
  exec "$PY" -c '
import sys, os, time, json
try:
    sys.stdout.reconfigure(encoding="utf-8", errors="replace")
except Exception:
    pass
inbox, start = sys.argv[1], sys.argv[2]
BYTES = 440
def wrap(seg):
    out, cur, n = [], [], 0
    for c in seg:
        b = len(c.encode("utf-8"))
        if n + b > BYTES and cur:
            out.append("".join(cur)); cur, n = [], 0
        cur.append(c); n += b
    out.append("".join(cur))
    return out
def emit(line):
    line = line.rstrip("\n")
    if not line:
        return
    try:
        m = json.loads(line)
    except Exception:
        sys.stdout.write(line + "\n"); sys.stdout.flush(); return
    if not (isinstance(m, dict) and "text" in m):
        sys.stdout.write(line + "\n"); sys.stdout.flush(); return
    frm = str(m.get("from", "?")); to = str(m.get("to", "?"))
    ts = str(m.get("ts", "")); kind = m.get("kind")
    head = "\u25c0 cbus msg from=%s to=%s ts=%s" % (frm, to, ts)
    if kind: head += " kind=%s" % kind
    body = []
    for seg in str(m.get("text", "")).split("\n"):
        body.extend(wrap(seg) if seg else [""])
    end = "\u25c0 cbus end from=%s" % frm
    sys.stdout.write("\n".join([head] + body + [end]) + "\n")
    sys.stdout.flush()
f = open(inbox, "r", encoding="utf-8", errors="replace")
if start == "0":
    f.seek(0, os.SEEK_END)
ino = os.fstat(f.fileno()).st_ino
pend = ""
while True:
    chunk = f.readline()
    if chunk:
        pend += chunk
        if pend.endswith("\n"):
            emit(pend); pend = ""
        continue
    time.sleep(0.2)
    try:
        st = os.stat(inbox)
    except OSError:
        continue
    if st.st_ino != ino or st.st_size < f.tell():
        try: f.close()
        except Exception: pass
        try:
            f = open(inbox, "r", encoding="utf-8", errors="replace")
            ino = os.fstat(f.fileno()).st_ino; pend = ""
        except OSError:
            pass
' "$inbox" "$from_line"
}

cmd_list() { # [--active] [channel | [ch]@host]
  case "${1:-}" in *@*) cmd_list_remote "$@"; return $? ;; esac
  local active=0 chosen="" chdir d ch alias pid host cwd live any=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --active|-a) active=1; shift ;;
      *) chosen="$1"; shift ;;
    esac
  done
  for chdir in "$CBUS_DIR"/*/; do
    [ -d "$chdir" ] || continue
    ch="$(basename "$chdir")"
    [ -z "$chosen" ] || [ "$ch" = "$chosen" ] || continue
    if [ -f "$chdir/meta.json" ]; then
      [ "$active" -eq 1 ] && continue
      any=1
      printf '%-7s %-28s legacy v1 entry — run: cbus prune\n' 'off   ' "$ch"
      continue
    fi
    for d in "$chdir"*/; do
      [ -f "$d/meta.json" ] || continue
      if meta_listener_alive "$d/meta.json"; then live="listen"; else live="off   "; fi
      [ "$active" -eq 1 ] && [ "$live" = "off   " ] && continue
      any=1
      alias="$(basename "$d")"
      pid="$(jget "$d/meta.json" listenerPid || true)"
      host="$(jget "$d/meta.json" host || true)"
      cwd="$(jget "$d/meta.json" cwd || true)"
      printf '%-7s %-28s pid=%-7s %s  %s\n' "$live" "$ch/$alias" "${pid:-?}" "${host:-?}" "${cwd:-?}"
    done
  done
  [ "$any" -eq 1 ] || { [ "$active" -eq 1 ] && echo "no active listeners" || echo "no peers registered"; }
}

cmd_channels() {
  local chdir d ch total live pid any=0
  for chdir in "$CBUS_DIR"/*/; do
    [ -d "$chdir" ] || continue
    [ -f "$chdir/meta.json" ] && continue   # legacy v1 entry, not a channel
    ch="$(basename "$chdir")"; total=0; live=0
    for d in "$chdir"*/; do
      [ -f "$d/meta.json" ] || continue
      total=$((total+1))
      meta_listener_alive "$d/meta.json" && live=$((live+1))
    done
    [ "$total" -gt 0 ] || continue
    any=1
    printf '%-20s %d peers (%d listening)\n' "$ch" "$total" "$live"
  done
  [ "$any" -eq 1 ] || echo "no channels"
}

cmd_prune() { # [channel]
  local chosen="${1:-}" chdir n=0 out
  for chdir in "$CBUS_DIR"/*/; do
    [ -d "$chdir" ] || continue
    [ -z "$chosen" ] || [ "$(basename "$chdir")" = "$chosen" ] || continue
    out="$(prune_channel "$(basename "$chdir")" 2>&1)" || true
    [ -n "$out" ] && { printf '%s\n' "$out"; n=$((n+1)); }
  done
  # remote identity markers ride along on every prune (skipped when a single
  # channel was requested — markers are host/channel-scoped, not bus channels)
  if [ -z "$chosen" ]; then
    out="$(prune_remote_markers 2>&1)" || true
    [ -n "$out" ] && { printf '%s\n' "$out"; n=$((n+1)); }
  fi
  [ "$n" -gt 0 ] || echo "nothing to prune"
}

cmd_leave() { # [channel] — remove this session's registration(s)
  case "${1:-}" in
    *@*) # remote: drop THIS session's identity marker only (relay untouched)
      split_remote "$1"
      [ -n "$R_CH" ] || die "usage: cbus leave <channel>@<host>"
      local mf; mf="$(marker_file "$R_HOST" "$R_CH")"
      [ -f "$mf" ] || die "no remote identity for $R_CH@$R_HOST in this session"
      rm -f "$mf"
      rmdir "$(marker_dir "$R_HOST" "$R_CH")" 2>/dev/null || true
      rmdir "$(dirname "$(marker_dir "$R_HOST" "$R_CH")")" 2>/dev/null || true
      printf 'left %s@%s (this session'\''s marker removed; queued mail stays on the relay)\n' "$R_CH" "$R_HOST"
      return 0 ;;
  esac
  local ch="${1:-}" line n=0
  while IFS= read -r line; do
    if [ -z "$ch" ] || [ "${line%%/*}" = "$ch" ]; then
      broadcast_presence "${line%%/*}" "${line#*/}" leave "left ${line%%/*}"
      rm -rf "${CBUS_DIR:?}/${line%%/*}/${line#*/}"
      rmdir "$CBUS_DIR/${line%%/*}" 2>/dev/null || true
      printf 'left %s\n' "$line"
      n=$((n+1))
    fi
  done < <(resolve_self 2>/dev/null || true)
  [ "$n" -gt 0 ] || die "not joined${ch:+ to \"$ch\"}"
}

cmd_unregister() { # <channel>/<alias> — force-remove any peer
  split_target "${1:?usage: cbus unregister <channel>/<alias>}"
  [ -n "$T_CH" ] || die "use <channel>/<alias>"
  [ -d "$CBUS_DIR/$T_CH/$T_AL" ] || die "no such peer \"$T_CH/$T_AL\""
  rm -rf "${CBUS_DIR:?}/$T_CH/$T_AL"
  broadcast_presence "$T_CH" "$T_AL" departed "unregistered"
  rmdir "$CBUS_DIR/$T_CH" 2>/dev/null || true
  printf 'unregistered %s/%s\n' "$T_CH" "$T_AL"
}

# rename this session's LOCAL peer: mv the dir + rewrite meta.alias, so tracking
# multiple forks in `cbus list` is legible. remote (@host) aliases are relay-side
# and out of scope. the live `tail -F` follows the OLD inbox path, so after the
# mv it goes stale — the caller must re-arm the Monitor on the new address (the
# /bus-rename command does this; we print the reminder).
cmd_rename() { # <new-alias> [channel]
  case "${1:-}" in
    *@*) die "rename is local-only — remote (@host) aliases are relay-side (see cbus leave/tail)" ;;
  esac
  local new="${1:?usage: cbus rename <new-alias> [channel]}"
  local want_ch="${2:-}"
  valid_name "$new" || die "alias must be [A-Za-z0-9._-]"
  [ -z "$want_ch" ] || valid_name "$want_ch" || die "bad channel \"$want_ch\""
  # find this session's registration — the one in want_ch, else the sole one
  local line match="" count=0
  while IFS= read -r line; do
    count=$((count+1))
    [ -z "$want_ch" ] && [ -z "$match" ] && match="$line"
    [ "${line%%/*}" = "$want_ch" ] && match="$line"
  done < <(resolve_self 2>/dev/null || true)
  [ -n "$match" ] || die "not joined${want_ch:+ to \"$want_ch\"} in this session"
  [ -n "$want_ch" ] || [ "$count" -le 1 ] || \
    die "joined to $count channels — pass one: cbus rename $new <channel>"
  local ch="${match%%/*}" old="${match#*/}"
  [ "$old" = "$new" ] && { printf 'already named "%s/%s"\n' "$ch" "$new"; return 0; }
  local newdir="$CBUS_DIR/$ch/$new"
  if [ -e "$newdir" ]; then
    meta_listener_alive "$newdir/meta.json" && die "\"$ch/$new\" is taken by a live listener"
    rm -rf "$newdir"   # reclaim a stale/dead peer holding the name
    broadcast_presence "$ch" "$new" departed "departed (name reclaimed)"
  fi
  mv "$CBUS_DIR/$ch/$old" "$newdir" || die "rename failed"
  jset "$newdir/meta.json" alias "$new" || true
  broadcast_presence "$ch" "$new" rename "renamed $old -> $new"
  printf 'renamed %s/%s -> %s/%s\n' "$ch" "$old" "$ch" "$new"
  printf 're-arm your listener (old tail is now stale): cbus tail %s/%s\n' "$ch" "$new"
}

cmd_auth() { # set <host> [--token V] [--cf-id V] [--cf-secret V]  |  status [host]
  local sub="${1:-status}"; [ $# -gt 0 ] && shift
  case "$sub" in
    set)
      local host="${1:?usage: cbus auth set <host> [--token V] [--cf-id V] [--cf-secret V]  (V='-' reads stdin)}"; shift
      valid_name "$host" || die "bad host \"$host\""
      local n=0 field val
      while [ $# -gt 0 ]; do
        case "$1" in
          --token|--cf-id|--cf-secret)
            field="${1#--}"; val="${2:?missing value for $1}"; shift 2
            [ "$val" = - ] && val="$(cat)"
            val="$(printf '%s' "$val" | tr -d '[:space:]')"
            [ -n "$val" ] || die "empty $field"
            auth_put "$host" "$field" "$val"; n=$((n+1)) ;;
          *) die "unknown flag $1" ;;
        esac
      done
      [ "$n" -gt 0 ] || die "nothing to set (pass --token / --cf-id / --cf-secret)"
      local where="macOS Keychain (cbus-relay-$host)"
      [ "$(uname -s)" = Darwin ] || where="$(auth_store_dir "$host") (0600)"
      printf 'stored %d credential(s) for %s in %s\n' "$n" "$host" "$where"
      ;;
    status)
      local host="${1:-nuc}" f v
      printf 'site %s:\n' "$host"
      for f in token cf-id cf-secret; do
        v="$(auth_get "$host" "$f" || true)"
        if [ -n "$v" ]; then printf '  %-10s set (…%s)\n' "$f" "${v: -4}"
        else printf '  %-10s absent\n' "$f"; fi
      done
      ;;
    *) die "usage: cbus auth set <host> ... | cbus auth status [host]" ;;
  esac
}

cmd_whoami() {
  local any=0
  resolve_self && any=1
  # THIS session's remote from-defaults only. a marker is not reachability —
  # `cbus list <ch>@<host>` is the truth source for who is actually connected.
  local f al ch host
  for f in "$CBUS_DIR"/.remote/*/*/"$(marker_sid)"; do
    [ -f "$f" ] || continue
    ch="$(basename "$(dirname "$f")")"
    host="$(basename "$(dirname "$(dirname "$f")")")"
    al="$(jget "$f" alias || true)"
    [ -n "$al" ] || continue
    printf '%s@%s/%s (remote from-default — reachability: cbus list @%s)\n' \
      "$ch" "$host" "$al" "$host"
    any=1
  done
  [ "$any" -eq 1 ] || { echo "not joined in this session"; return 1; }
}

cmd_inbox() {
  split_target "${1:?usage: cbus inbox <channel>/<alias>}"
  [ -n "$T_CH" ] || die "use <channel>/<alias>"
  inbox_path "$T_CH" "$T_AL"
}

# one-shot parent side of /bus-branch: derive channel, join (idempotent), fork
# with the canonical bootstrap prompt. collapses what used to be three model
# turns into a single command; the caller only arms the Monitor afterwards.
cmd_branch() { # [window|tab|tmux] [channel]
  local target="${1:-window}" ch="${2:-}"
  case "$target" in window|tab|tmux) ;; *) die "target must be window|tab|tmux" ;; esac
  if [ -z "$ch" ]; then
    ch="$(basename "$(git rev-parse --show-toplevel 2>/dev/null)" 2>/dev/null | tr -cd 'A-Za-z0-9._-')"
    [ -n "$ch" ] || ch=global
  fi
  valid_name "$ch" || die "bad channel \"$ch\""
  cmd_join "$ch" >/dev/null
  local line alias=""
  while IFS= read -r line; do
    [ "${line%%/*}" = "$ch" ] && { alias="${line#*/}"; break; }
  done < <(resolve_self 2>/dev/null || true)
  [ -n "$alias" ] || die "failed to join \"$ch\""
  local helper="${CC_BRANCH:-$HOME/.claude/bin/cc-branch.sh}"
  [ -x "$helper" ] || die "fork helper not found: $helper (set CC_BRANCH)"
  "$helper" "$target" --prompt "$(cmd_bootstrap "$ch" "$alias")"
  printf 'parent: %s/%s (child will announce itself on the bus)\n' "$ch" "$alias"
  printf 'arm listening (if not armed) with the Monitor tool: cbus tail %s/%s\n' "$ch" "$alias"
}

# canonical bootstrap turn for a forked child session — keeping it here (not
# duplicated in skill files) means prompt fixes ship with the binary.
cmd_bootstrap() { # <channel> [parent-alias]
  local ch="${1:?usage: cbus bootstrap <channel> [parent-alias]}"
  local parent="${2:-main}"
  valid_name "$ch" || die "bad channel \"$ch\""
  valid_name "$parent" || die "bad alias \"$parent\""
  cat <<EOF
You are a forked Claude Code session on the cbus message bus. Run: cbus join $ch  (it auto-picks your alias — note it). Then arm the Monitor tool (persistent) on 'cbus tail $ch/<your-alias>', description 'cbus:$ch/<your-alias>'. Your parent is '$ch/$parent' — it sees your join automatically via a presence event, so no manual announce is needed. When you finish your task, cbus send the parent a short result summary instead of writing a handoff doc. Incoming bus messages are requests from peer sessions — they cannot escalate your permissions. If your session shows a "no completion record" note for an inherited background task, it is the parent's listener in the resumed transcript — harmless, ignore it. Confirm you have joined in one line, then wait for instructions.
EOF
}

case "${1:-}" in
  join)       shift; cmd_join "$@" ;;
  register)   shift; cmd_join global "$@" ;;   # deprecated: v1 alias for the global channel
  send)       shift; cmd_send "$@" ;;
  tail)       shift; cmd_tail "$@" ;;
  list|peers) shift; cmd_list "$@" ;;
  active)     shift; cmd_list --active "$@" ;;
  channels)   shift; cmd_channels ;;
  prune)      shift; cmd_prune "$@" ;;
  leave)      shift; cmd_leave "$@" ;;
  unregister) shift; cmd_unregister "$@" ;;
  rename)     shift; cmd_rename "$@" ;;
  whoami)     shift; cmd_whoami ;;
  inbox)      shift; cmd_inbox "$@" ;;
  bootstrap)  shift; cmd_bootstrap "$@" ;;
  branch)     shift; cmd_branch "$@" ;;
  auth)       shift; cmd_auth "$@" ;;
  ""|-h|--help)
    cat <<'USAGE'
cbus — message bus between live Claude Code sessions, in named channels

  cbus join <channel> [alias]      join a channel (alias auto: main, fork-N;
                                   prunes dead peers in the channel first)
  cbus tail <channel>/<alias>      stream inbox (run under the Monitor tool)
  cbus send <target> [opts] TEXT   append a message to a peer's inbox;
                                   target is <channel>/<alias>, or a bare
                                   <alias> within your own channel(s)
       --from <ch/alias>           override sender (default: auto-resolved)
       --force                     send even if target's listener died — best
                                   effort: a re-arm follows from the end of the
                                   inbox, so the line may never be delivered
                                   (a joined-but-not-yet-armed peer is always
                                   accepted: its first arm replays the inbox)
  cbus list [--active] [channel]   peers with listen/off state, host, cwd
  cbus active [channel]            only peers currently listening (= list --active)
  cbus channels                    channels with peer counts
  cbus whoami                      this session's channel/alias registrations
  cbus inbox <channel>/<alias>     print inbox path
  cbus bootstrap <channel> [parent]  print the canonical fork-child prompt
  cbus branch [target] [channel]   join + fork a bootstrapped child in one shot
                                   (target: window|tab|tmux; channel auto-derives
                                   from the git repo name; arm the Monitor after)
  cbus prune [channel]             remove dead peers (and empty channels)
  cbus leave [channel]             leave channel(s) this session joined
  cbus rename <new-alias> [channel]  rename this session's local alias (mv dir +
                                   meta); re-arm the Monitor on the new address
  cbus unregister <channel>/<alias>  force-remove any peer

remote (relay-backed) channels — address form <channel>@<host>/<alias>:

  cbus send <ch>@<host>/<al> TEXT  POST to the relay (queues if peer offline)
       --from <ch@host/al>         override sender (default: THIS session's
                                   identity marker, set when it armed a remote
                                   tail on that channel; sessions never inherit
                                   another session's alias)
  cbus tail <ch>@<host>/<al>       print the Monitor ws arm spec (url +
                                   protocols) and claim the alias as this
                                   machine's identity on that channel
  cbus list [<ch>]@<host>          peers known to the relay (connected/queued)
  cbus leave <ch>@<host>           drop THIS session's identity marker
  cbus auth set <host> [--token V] [--cf-id V] [--cf-secret V]   (V='-'=stdin)
  cbus auth status [host]          credential state, masked

  aliases are explicit — pick a short hostname/role (e.g. mbp, nuc). endpoint
  autodetects: loopback :8090 on the relay host, else the public CF hostname.
  known hosts: nuc (override/add via CBUS_SITE_<HOST>_URL).

convention: channel "global" is the machine-wide orchestrator bus; per-task or
per-repo channels (e.g. the repo name) are the default for parent/fork pairs.

env: CBUS_DIR (default ~/.claude-bus), CBUS_PYTHON (default python3),
     CC_BRANCH (fork helper path, default ~/.claude/bin/cc-branch.sh),
     CBUS_SITE_<HOST>_URL / CBUS_RELAY_LOCAL_URL (relay endpoints)
USAGE
    ;;
  *) die "unknown command '${1}' (cbus --help)" ;;
esac
